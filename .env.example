# Copy to .env and fill in. .env is git-ignored; never commit real values.

# SMTP for the bulk-email pages (Gmail needs an app password, not your login).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="FOM <you@example.com>"

# Base URL used in emailed links (e.g. doctor invitation links).
BASE_URL=http://aaa.localhost:3000

# Optional: where tenant-private files live (default: ../tenant-files).
# TENANT_FILES_DIR=/path/to/tenant-files
