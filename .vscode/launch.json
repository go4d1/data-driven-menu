{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Server + FOMTEST",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/index.js",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "http://127\\.0\\.0\\.1:([0-9]+)",
                "uriFormat": "http://aaa.medicalpod.fom/:%s/fomtest.html",
                "action": "openExternally"
            }
        },
        {
            "name": "Debug Server Only",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/index.js",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open fom.html",
            "type": "chrome",
            "request": "launch",
            "file": "/Users/martinglynn/Desktop/Claude/CleanStart/fom.html"
        }
    ]
}
